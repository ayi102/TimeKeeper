# Copy to .env.local and fill in. Never commit real secrets.

# The business/local timezone used for all stored wall-clock times.
# Must be an IANA zone. This is what "now" means for clock-in/out, schedules,
# and reminders — set it to where the tablet physically is.
TIMEKEEPER_TZ=America/New_York

# Supabase — from your project's API settings.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only key used by API routes for privileged DB access. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection string (Supabase → Database → Connection string → URI).
# Use the pooled connection for serverless.
DATABASE_URL=postgres://postgres:PASSWORD@HOST:6543/postgres

# Grace windows (minutes) — mirror the tablet app defaults.
TIMEKEEPER_EARLY_GRACE_MIN=15
TIMEKEEPER_OVERTIME_MIN=60

# Secret that Vercel Cron requests must present (Authorization: Bearer ...).
CRON_SECRET=generate-a-long-random-string

# Mail (daily summary + backup). SMTP, e.g. Gmail app password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_TO=
MAIL_FROM=
